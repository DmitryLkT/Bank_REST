<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="v1-2" author="Dmitry Lk">
        <createTable tableName="users">

            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="surname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="age" type="int">
                <constraints nullable="false"/>
            </column>

            <column name="role" type="VARCHAR(25)" defaultValue="USER">
                <constraints nullable="false"/>
            </column>

        </createTable>
    </changeSet>

    <changeSet id="v1-add-check-role" author="Dmitry Lk">
        <sql>
            ALTER TABLE users ADD CONSTRAINT chek_user_role CHECK (role IN ('USER', 'ADMIN'));
        </sql>
    </changeSet>
</databaseChangeLog>