<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="v1-1" author="Dmitry Lk">
        <createTable tableName="cards">

            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="card_number_encrypted" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="owner_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="issue_date" type="DATE" defaultValueComputed="CURRENT_DATE">
                <constraints nullable="false"/>
            </column>

            <column name="expiry_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>

            <column name="balance" type="DECIMAL(15,2)" defaultValue="0.00">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="v1-add-check-status" author="Dmitry Lk">
        <sql>
            ALTER TABLE cards ADD CONSTRAINT chek_card_status CHECK (status IN ('ACTIVE', 'BLOCKED', 'EXPIRED'));
        </sql>
    </changeSet>

    <changeSet id="v1-2-drop-issue-date" author="Dmitry Lk">
        <dropColumn tableName="cards" columnName="issue_date"/>
    </changeSet>
    
    <changeSet id="v1-2-add-flag-block" author="Dmitry Lk">
        <addColumn tableName="cards">
            <column name="flag_block" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>